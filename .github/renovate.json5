{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // https://docs.renovatebot.com/presets-default/#configmigration
    ':configMigration',
    // https://docs.renovatebot.com/presets-customManagers/#custommanagersgithubactionsversions
    // Update _VERSION environment variables in GitHub Action files.
    'customManagers:githubActionsVersions',
    'customManagers:dockerfileVersions',
  ],
  schedule: ["* * 1,15 * *"],
  prHourlyLimit: 10,
  labels: [
    'internal'
  ],
  semanticCommits: 'disabled',
  cargo: {
    // See https://docs.renovatebot.com/configuration-options/#rangestrategy
    rangeStrategy: "update-lockfile",
  },
  // Pin GitHub Actions references in documentation to immutable SHAs.
  'github-actions': {
    managerFilePatterns: [
      '/README\\.md$/',
      '/^docs/.*\\.md$/',
    ],
  },
  enabledManagers: [
    'github-actions',
    'cargo',
    'custom.regex',
    'dockerfile',
    'pep621',
    'rust-toolchain',
  ],
  customManagers: [
    // Release tool versions are shared by CI and Docker builds.
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/install-cargo-tools\\.sh$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION=(?<currentValue>\\S+)',
      ],
      versioningTemplate: 'semver',
    },
    // Update komac and its release archive checksum together.
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/publish-winget\\.yml$/'],
      matchStrings: [
        'KOMAC_VERSION:\\s*"(?<currentValue>v[^"]+)"\\s+KOMAC_SHA256:\\s*"(?<currentDigest>[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'github-release-attachments',
      depNameTemplate: 'komac',
      packageNameTemplate: 'russellbanks/Komac',
    },
    // Update `uv` version in `crates/prek/src/languages/python/uv.rs` and CI workflows.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/src/languages/python/uv.rs$/',
        '/.github/workflows/.*\\.yml$/',
      ],
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'uv',
      matchStrings: [
        'const\\s+DEFAULT_UV_VERSION\\s*:\\s*&str\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        'UV_VERSION:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ]
    },
    // Minimum supported Rust toolchain version
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)Cargo\\.toml$/"],
      matchStrings: [
        'rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)"',
      ],
      depNameTemplate: "msrv",
      packageNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
    }
  ],
  packageRules: [
    // Bump Python dependencies without raising the minimum supported Python version.
    {
      groupName: 'Python dependencies',
      matchManagers: ['pep621'],
      matchDepTypes: ['!requires-python'],
      rangeStrategy: 'bump',
      separateMajorMinor: false,
    },
    {
      groupName: 'CI tools',
      matchManagers: ['custom.regex'],
      matchFileNames: [
        '.github/workflows/**',
        'scripts/install-cargo-tools.sh',
        'crates/prek/src/languages/python/uv.rs',
      ],
      separateMajorMinor: false,
    },
    // Group all GitHub Actions updates together
    {
      groupName: 'GitHub Actions',
      matchManagers: ['github-actions'],
      matchDepTypes: ['action'],
      // Pin GitHub Actions to immutable SHAs
      pinDigests: true
    },
    {
      groupName: 'Docker images',
      matchManagers: ['dockerfile'],
      minimumGroupSize: 2,
      separateMajorMinor: false,
    },
    // Disable updates for GitHub runners: we'd only pin them to a specific version
    // if there was a deliberate reason to do so
    {
      matchDatasources: ['github-runners'],
      enabled: false
    },
    {
      matchManagers: [ 'cargo', 'github-actions', 'pep621', 'custom.regex', 'dockerfile', 'rust-toolchain' ],
      minimumReleaseAge: '7 days'
    },
    {
      commitMessageTopic: "MSRV",
      matchManagers: ["custom.regex"],
      matchDepNames: ["msrv"],
      // We have a rolling support policy for the MSRV
      // 2 releases back * 6 weeks per release * 7 days per week + 1
      minimumReleaseAge: "85 days",
      internalChecksFilter: "strict",
      groupName: "MSRV",
    }
  ]
}
